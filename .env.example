# Kopier denne til .env.local og fyll inn der det er aktuelt.
# Ingen av variablene er påkrevd for at nettsiden skal kjøre.

# Adressen nettsiden ligger på. Brukes til sitemap, hreflang og deling.
NEXT_PUBLIC_SITE_URL=https://nsports.no

# Stripen øverst om at produktdata er utkast. Sett til "off" når endelige
# bilder og spesifikasjoner er på plass.
NEXT_PUBLIC_DRAFT_BANNER=on

# --- Kontaktskjema -----------------------------------------------------
# Uten RESEND_API_KEY logges henvendelser til serverloggen i stedet for å
# sendes. Skjemaet fungerer, men ingen e-post går ut.
# Nøkkel hentes på https://resend.com
RESEND_API_KEY=
# Avsender må ligge på et domene som er verifisert i Resend.
ENQUIRY_FROM=NSports <post@nsports.no>
# Mottaker. Uten denne brukes e-postadressen i content/site.json.
ENQUIRY_TO=

# --- Sanity ------------------------------------------------------------
# Så snart NEXT_PUBLIC_SANITY_PROJECT_ID er satt, leses innholdet fra Sanity
# i stedet for fra JSON-filene i content/. Se sanity/README.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Bare nødvendig hvis datasettet ikke er åpent for lesing.
SANITY_READ_TOKEN=
